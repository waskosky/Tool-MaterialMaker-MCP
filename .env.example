# Copy to .env and set for your machine. The real .env is gitignored.

# Path to the Godot 4.7.x binary. Prefer the _console.exe build so render
# logs are captured on Windows; use the desktop executable on macOS/Linux.
# Example on macOS: /Applications/Godot.app/Contents/MacOS/Godot
MM_GODOT_BINARY=

# Path to a Material Maker project checkout (contains project.godot, addons/, examples/).
# Needs steam_appid.txt (4110830) at its root or Material Maker relaunches itself and exits.
MM_PROJECT_PATH=

# Where rendered maps and saved .ptex files go (defaults to ./output if unset).
MM_OUTPUT_DIR=

# Persistent projects, history, recipes, jobs, and builds (defaults to
# <MM_OUTPUT_DIR>/workspace). Use a fresh workspace when upgrading from 0.7.
MM_WORKSPACE_DIR=

# Optional approved paths, preferably a JSON array: ["/absolute/output", "/absolute/assets"]
# Defaults to the workspace and output directories when empty.
MM_ALLOWED_ROOTS=

# Maximum build resolution: a power of two from 32 to 4096.
MM_MAX_RESOLUTION=2048

# New inline shaders and experimental native editor writes are opt-in.
# See docs/upgrade/SECURITY.md and TESTING.md before enabling either setting.
MM_ALLOW_CUSTOM_SHADERS=0
MM_ENABLE_EXPERIMENTAL_LIVE_WRITES=0

# Where the disposable live-control overlay is built (optional; defaults to
# ./mm_live_overlay under the current working directory if unset)
MM_LIVE_OVERLAY_DIR=

# Where the tracked cookbook of authored graphs lives (optional; defaults to
# the checkout's ./cookbook folder if unset; see cookbook/README.md)
MM_COOKBOOK_DIR=

# Port for the mm-play web page (optional; defaults to 8788)
MM_PLAY_PORT=

# Minutes without a tool call before the server exits on its own (optional;
# 0 = never, the default). Claude Code does not restart an exited stdio
# server, so the next call in a long-idle session fails until the session
# reconnects.
# MM_IDLE_EXIT_MINUTES=
