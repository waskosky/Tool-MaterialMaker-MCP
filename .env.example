# Copy to .env and set for your machine. The real .env is gitignored.
# Native paths can also be saved in the browser's Setup & repair panel.
# Native precedence: process environment > nonempty .env > saved per-user defaults.
# Blank .env values are ignored. An explicitly empty MM_GODOT_BINARY or
# MM_PROJECT_PATH process environment variable clears that effective native path.
# Unset the process variable to use .env or saved defaults again.
# See docs/upgrade/SETUP.md for installation and repair instructions.

# Process environment only: MM_SETTINGS_FILE selects the native defaults JSON file.
# Setting MM_SETTINGS_FILE inside .env has no effect. Without it, defaults live in
# the current user's MaterialWorkshop configuration directory.
# MM_SETTINGS_FILE=/absolute/path/to/settings.json

# Path to the Godot 4.7.x binary. Prefer the _console.exe build so render
# logs are captured on Windows; use the desktop executable on macOS/Linux.
# Example on macOS: /Applications/Godot.app/Contents/MacOS/Godot
MM_GODOT_BINARY=

# Path to a Material Maker source checkout containing project.godot and
# addons/material_maker/nodes. A packaged Material Maker app is not a source checkout.
MM_PROJECT_PATH=

# Where rendered maps and saved .ptex files go (defaults to ./output if unset).
MM_OUTPUT_DIR=

# Persistent projects, history, recipes, jobs, and builds (defaults to
# <MM_OUTPUT_DIR>/workspace). Use a fresh workspace when upgrading from 0.7.
MM_WORKSPACE_DIR=

# Optional approved paths, preferably a JSON array: ["/absolute/output", "/absolute/assets"]
# Defaults to the workspace and output directories when empty.
MM_ALLOWED_ROOTS=

# Maximum build resolution: a power of two from 32 to 4096.
# An empty process environment value is invalid; an empty .env value is ignored.
MM_MAX_RESOLUTION=2048

# New inline shaders and experimental native editor writes are opt-in.
# See docs/upgrade/SECURITY.md and TESTING.md before enabling either setting.
MM_ALLOW_CUSTOM_SHADERS=0
MM_ENABLE_EXPERIMENTAL_LIVE_WRITES=0

# Where the disposable live-control overlay is built (optional; defaults to
# ./mm_live_overlay under the current working directory if unset)
MM_LIVE_OVERLAY_DIR=

# Where the tracked cookbook of authored graphs lives (optional; defaults to
# the checkout's ./cookbook folder if unset; see cookbook/README.md)
MM_COOKBOOK_DIR=

# Port for the mm-play web page (optional; defaults to 8788)
MM_PLAY_PORT=

# Optional operator-managed companion hosting. Mounts are canonical /segments/
# paths. Origin is one HTTPS host origin or HTTP loopback origin, without a path.
# Defaults: root mount, no public origin, no Foundry navigation, random launch token.
# MM_BASE_PATH=/shadermaker/workshop/
# MM_PUBLIC_ORIGIN=https://w11.tailbcac65.ts.net
# MM_FOUNDRY_PATH=/shadermaker/
# MM_SESSION_TOKEN_FILE=/private/operator-state/companion.token
# Managed token file: private regular file, current owner, 64 hex characters.
# Set MM_MAX_RESOLUTION=1024 above when Foundry is the consumer.

# Minutes without a tool call before the server exits on its own (optional;
# 0 = never, the default). Claude Code does not restart an exited stdio
# server, so the next call in a long-idle session fails until the session
# reconnects.
# MM_IDLE_EXIT_MINUTES=
